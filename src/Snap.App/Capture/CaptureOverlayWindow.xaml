<Window x:Class="Snap.App.Capture.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        KeyDown="OnKeyDown">
    <Grid>
        <Image x:Name="DesktopImage" Stretch="Fill" IsHitTestVisible="False" />

        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                MouseLeftButtonDown="OnMouseLeftButtonDown"
                MouseMove="OnMouseMove"
                MouseLeftButtonUp="OnMouseLeftButtonUp">
            <Rectangle x:Name="TopShade" Fill="#8A000000" />
            <Rectangle x:Name="LeftShade" Fill="#8A000000" />
            <Rectangle x:Name="RightShade" Fill="#8A000000" />
            <Rectangle x:Name="BottomShade" Fill="#8A000000" />

            <Canvas x:Name="AnnotationCanvas"
                    Visibility="Collapsed"
                    Background="Transparent"
                    ClipToBounds="True"
                    MouseLeftButtonDown="OnAnnotationMouseLeftButtonDown"
                    MouseMove="OnAnnotationMouseMove"
                    MouseLeftButtonUp="OnAnnotationMouseLeftButtonUp" />

            <Border x:Name="SelectionBorder"
                    Visibility="Collapsed"
                    BorderBrush="#07C160"
                    BorderThickness="2"
                    Background="Transparent"
                    IsHitTestVisible="False" />

            <Border x:Name="SizeBadge"
                    Visibility="Collapsed"
                    Padding="7,3"
                    CornerRadius="3"
                    Background="#C9242424">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="13" />
            </Border>

            <Border x:Name="ActionBar"
                    Visibility="Collapsed"
                    Padding="8,7"
                    CornerRadius="8"
                    Background="#FFF9F9F9">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="□" Tag="Rectangle" ToolTip="矩形" Click="OnToolClick" />
                    <Button Style="{StaticResource ToolButton}" Content="○" Tag="Ellipse" ToolTip="椭圆" Click="OnToolClick" />
                    <Button Style="{StaticResource ToolButton}" Content="☺" Tag="Emoji" ToolTip="表情" Click="OnToolClick" />
                    <Button Style="{StaticResource ToolButton}" Content="↗" Tag="Arrow" ToolTip="箭头" Click="OnToolClick" />
                    <Button Style="{StaticResource ToolButton}" Content="✎" Tag="Pen" ToolTip="画笔" Click="OnToolClick" />
                    <Button Style="{StaticResource ToolButton}" Content="▦" Tag="Mosaic" ToolTip="遮挡" Click="OnToolClick" />
                    <Button Style="{StaticResource ToolButton}" Content="T" Tag="Text" ToolTip="文字" Click="OnToolClick" />
                    <Button Style="{StaticResource ToolButton}" Content="⇳" ToolTip="滚动长截图（即将接入）" IsEnabled="False" />
                    <Button Style="{StaticResource ToolButton}" Content="↶" ToolTip="撤销" Click="OnUndoClick" />
                    <Button Style="{StaticResource ToolButton}" Content="⇩" ToolTip="保存" Click="OnSaveClick" />
                    <Button Style="{StaticResource ToolButton}" Content="⚑" ToolTip="钉图" Click="OnPinClick" />
                    <Rectangle Width="1" Height="24" Fill="#FFE1E1E1" Margin="5,0" />
                    <Button Style="{StaticResource ToolButton}" Content="×" Foreground="#FFFF3B30" ToolTip="取消" Click="OnCancelClick" />
                    <Button Style="{StaticResource ToolButton}" Content="✓" Foreground="#FF07C160" ToolTip="完成" Click="OnDoneClick" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>

    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FFEAEAEA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
