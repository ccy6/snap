<Window x:Class="Snap.App.Capture.CaptureImageWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="截图预览" Width="1000" Height="720" MinWidth="400" MinHeight="300"
 WindowStyle="None" ResizeMode="CanResize"
 Background="#F7F7F7" Foreground="#454549" FontFamily="Segoe UI, Microsoft YaHei UI"
 WindowStartupLocation="CenterOwner" PreviewKeyDown="OnPreviewKeyDown">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Border BorderBrush="#D4D4D7" BorderThickness="1" Background="#F7F7F7">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/></Grid.RowDefinitions>
   <Grid Background="#E8E8EB">
    <ToggleButton x:Name="PinPreviewButton" HorizontalAlignment="Left" Width="54" Height="46"
     IsChecked="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
     shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="置顶图片">
     <ToggleButton.Style><Style TargetType="ToggleButton">
      <Setter Property="ToolTip" Value="置顶"/>
      <Setter Property="Foreground" Value="#454549"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="PinBackground" Background="Transparent">
        <Path Data="M 6,1 L 14,1 L 13,7 L 17,12 L 17,14 L 3,14 L 3,12 L 7,7 Z M 10,14 L 10,20"
         Width="16" Height="20" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PinBackground" Property="Background" Value="#DCDCDF"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PinBackground" Property="Background" Value="#DCDCDF"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="PinBackground" Property="Background" Value="#CEDDD3"/><Setter Property="Foreground" Value="#315C43"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="ToolTip" Value="取消置顶"/></Trigger></Style.Triggers>
     </Style></ToggleButton.Style>
    </ToggleButton>
    <Button x:Name="ClosePreviewButton" HorizontalAlignment="Right" Width="50" Height="46"
     Click="OnCloseClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"
     AutomationProperties.Name="关闭图片" ToolTip="关闭">
     <Button.Template><ControlTemplate TargetType="Button">
      <Border x:Name="CloseBackground" Background="Transparent">
       <Path x:Name="CloseIcon" Data="M 0,0 L 11,11 M 11,0 L 0,11" Stroke="#454549" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseBackground" Property="Background" Value="#C83E3E"/><Setter TargetName="CloseIcon" Property="Stroke" Value="White"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CloseBackground" Property="Background" Value="#DCDCDF"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate></Button.Template>
    </Button>
   </Grid>
   <ScrollViewer x:Name="ImageScroll" Grid.Row="1" Background="#F7F7F7" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnImageMouseWheel" SizeChanged="OnViewportSizeChanged">
    <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
   </ScrollViewer>
  </Grid>
 </Border>
</Window>
