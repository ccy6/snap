<Window x:Class="Snap.App.Capture.PinnedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        AllowsTransparency="True"
        MouseLeftButtonDown="OnMouseLeftButtonDown"
        MouseWheel="OnMouseWheel"
        MouseRightButtonUp="OnMouseRightButtonUp">
    <Border BorderBrush="#FF41785A" BorderThickness="1" Background="#FFF4F3EF" ToolTip="拖动移动 · 滚轮缩放 · 右键关闭">
        <Image x:Name="PinnedImage" Stretch="Uniform" MaxWidth="900" MaxHeight="700" />
    </Border>
</Window>
