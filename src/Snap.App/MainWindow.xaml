<Window x:Class="Snap.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Snap · 截图台" Width="1060" Height="740" MinWidth="820" MinHeight="560"
 Icon="Assets/Snap.ico" WindowStartupLocation="CenterScreen" Background="#F4F3EF"
 FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#242824" Closing="OnClosing">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#303C34"/>
   <Setter Property="BorderBrush" Value="#D6DBD4"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#41785A"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.6"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="FontSize" Value="14"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="Tab" Padding="0,12,28,12" BorderThickness="0,0,0,2" BorderBrush="Transparent">
     <ContentPresenter x:Name="HeaderContent" ContentSource="Header" TextElement.Foreground="#6C756E"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderContent" Property="TextElement.Foreground" Value="#244E38"/><Setter TargetName="HeaderContent" Property="TextElement.FontWeight" Value="SemiBold"/><Setter TargetName="Tab" Property="BorderBrush" Value="#41785A"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderContent" Property="TextElement.Foreground" Value="#244E38"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="32,24,32,18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="40" Height="40" Background="#263F31" CornerRadius="9" Margin="0,0,12,0">
     <TextBlock Text="S" FontFamily="Georgia" FontSize="25" Foreground="#F3F4EA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel><TextBlock Text="Snap" FontFamily="Georgia" FontSize="28"/><TextBlock Text="截图与标注" FontSize="11" Foreground="#777E76"/></StackPanel>
   </StackPanel>
   <Button Grid.Column="1" Background="#315C43" Foreground="White" BorderBrush="#315C43" Click="OnStartCaptureClick" ToolTip="开始一次新的屏幕截图">
    <StackPanel Orientation="Horizontal"><TextBlock Text="＋  截图" FontWeight="SemiBold"/><TextBlock x:Name="CaptureHotkeyLabel" Margin="20,0,0,0" Foreground="#CDDCCF"/></StackPanel>
   </Button>
  </Grid>
  <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
   <TabItem Header="截图台">
    <Grid Margin="0,24,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><TextBlock Text="最近截图" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Captures.Count, StringFormat={}共 {0} 张}" Foreground="#777E76" Margin="12,6,0,0"/></StackPanel>
      <TextBlock Grid.Column="1" Text="双击查看大图 · 右键更多操作" Foreground="#777E76" VerticalAlignment="Center" FontSize="12"/>
     </Grid>
     <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Captures.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="还没有截图" FontSize="22" Foreground="#46564A" HorizontalAlignment="Center"/>
      <TextBlock Text="按右上角的快捷键，或点击「截图」开始。" Margin="0,12,0,24" Foreground="#777E76"/>
      <Button Content="开始第一张截图" Click="OnStartCaptureClick" HorizontalAlignment="Center"/>
     </StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Captures}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border Width="224" Margin="0,0,16,18" Background="White" BorderBrush="#DDDFD7" BorderThickness="1" CornerRadius="6">
         <Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="查看大图" Click="OnOpenCaptureClick"/>
          <Separator/>
          <MenuItem Header="复制" CommandParameter="{Binding}" Click="OnCopyCaptureClick"/>
          <MenuItem Header="另存为…" CommandParameter="{Binding}" Click="OnSaveCaptureClick"/>
          <MenuItem Header="钉到桌面" CommandParameter="{Binding}" Click="OnPinCaptureClick"/>
          <Separator/><MenuItem Header="保留 / 取消保留" CommandParameter="{Binding}" Click="OnToggleKeepClick"/>
          <MenuItem Header="删除" CommandParameter="{Binding}" Click="OnDeleteCaptureClick"/>
         </ContextMenu></Border.ContextMenu>
         <Grid><Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="46"/></Grid.RowDefinitions>
          <Button MouseDoubleClick="OnOpenCaptureClick" PreviewKeyDown="OnCaptureThumbnailKeyDown" Padding="10" Background="#E9EBE5" BorderThickness="0" ToolTip="双击查看原图" AutomationProperties.Name="查看截图大图">
           <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Button>
          <Grid Grid.Row="1" Margin="12,0"><TextBlock Text="{Binding CreatedLabel}" FontSize="12" VerticalAlignment="Center" Foreground="#626C63"/>
           <TextBlock Text="已保留" Foreground="#41785A" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsKept, Converter={StaticResource BooleanToVisibilityConverter}}"/>
          </Grid>
         </Grid>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Header="设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,28,0,24" MaxWidth="760" HorizontalAlignment="Stretch">
      <TextBlock Text="偏好设置" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,24"/>
      <Border Background="White" BorderBrush="#DDDFD7" BorderThickness="1" CornerRadius="6" Padding="24">
       <StackPanel>
        <TextBlock Text="截图快捷键" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="HotkeyHint" Text="全局生效 · 点击更改后录入新的组合键" Foreground="#777E76" Margin="0,8,0,20"/>
        <StackPanel Orientation="Horizontal">
         <TextBox x:Name="CaptureHotkeyBox" Width="200" Height="40" Padding="12,9" Background="#F4F5F1" BorderBrush="#D6DBD4" IsReadOnly="True" FontWeight="SemiBold" TextAlignment="Center" PreviewKeyDown="OnCaptureHotkeyPreviewKeyDown" LostKeyboardFocus="OnCaptureHotkeyLostFocus" AutomationProperties.Name="当前截图快捷键"/>
         <Button Content="更改" Margin="12,0,0,0" Click="OnChangeHotkeyClick"/>
        </StackPanel>
       </StackPanel>
      </Border>
      <Border Background="White" BorderBrush="#DDDFD7" BorderThickness="1" CornerRadius="6" Padding="24" Margin="0,16,0,0">
       <StackPanel>
        <TextBlock Text="截图保留时间" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="自动清理过期截图。标记为「保留」的图片不受影响。" Foreground="#777E76" Margin="0,8,0,20" TextWrapping="Wrap"/>
        <ComboBox x:Name="RetentionComboBox" Width="200" Height="36" Padding="10,6" HorizontalAlignment="Left" SelectionChanged="OnRetentionSelectionChanged">
         <ComboBoxItem Content="每天清理"/><ComboBoxItem Content="保留 7 天"/><ComboBoxItem Content="保留 30 天"/>
        </ComboBox>
       </StackPanel>
      </Border>
      <TextBlock Text="Snap · 本地保存，无需登录" Foreground="#858C83" FontSize="12" Margin="0,24,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="#DDDFD7" BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,16,0,0">
   <TextBlock Text="关闭窗口后，Snap 仍在系统托盘运行。" Foreground="#858C83" FontSize="11"/>
  </Border>
 </Grid>
</Window>
