<Window x:Class="Snap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snap"
        Width="960"
        Height="680"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5"
        Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" BorderBrush="#FFE5E5E5" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Snap" FontSize="25" FontWeight="SemiBold" Foreground="#FF191919" />
                    <TextBlock Text="今天的截图，随手可取" FontSize="12" Foreground="#FF888888" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="108"
                        Height="38"
                        Content="开始截图"
                        Foreground="White"
                        Background="#FF07C160"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnStartCaptureClick" />
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="20" Background="Transparent" BorderThickness="0">
            <TabItem Header="截图台">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <ItemsControl ItemsSource="{Binding Captures}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="200"
                                        Height="158"
                                        Margin="8"
                                        Padding="7"
                                        CornerRadius="8"
                                        Background="White"
                                        BorderBrush="#FFE4E4E4"
                                        BorderThickness="1">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="复制" CommandParameter="{Binding}" Click="OnCopyCaptureClick" />
                                            <MenuItem Header="另存为…" CommandParameter="{Binding}" Click="OnSaveCaptureClick" />
                                            <MenuItem Header="钉到桌面" CommandParameter="{Binding}" Click="OnPinCaptureClick" />
                                            <Separator />
                                            <MenuItem Header="保留 / 取消保留" CommandParameter="{Binding}" Click="OnToggleKeepClick" />
                                            <MenuItem Header="删除" CommandParameter="{Binding}" Click="OnDeleteCaptureClick" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="26" />
                                        </Grid.RowDefinitions>
                                        <Image Source="{Binding Image}" Stretch="Uniform" />
                                        <Border HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Padding="6,2"
                                                CornerRadius="8"
                                                Background="#E607C160"
                                                Visibility="{Binding IsKept, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="保留" Foreground="White" FontSize="11" />
                                        </Border>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding CreatedLabel}"
                                                   VerticalAlignment="Bottom"
                                                   Foreground="#FF777777"
                                                   FontSize="12" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="设置">
                <StackPanel Margin="18,24" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="快捷键" FontSize="18" FontWeight="SemiBold" />
                    <Border Margin="0,12,0,24" Padding="16" CornerRadius="8" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="开始截图" VerticalAlignment="Center" />
                                <TextBlock Text="点击右侧后，直接按下新的组合键" Margin="0,4,0,0"
                                           FontSize="12" Foreground="#FF888888" />
                            </StackPanel>
                            <TextBox x:Name="CaptureHotkeyBox"
                                     Grid.Column="1"
                                     Width="150"
                                     Height="34"
                                     Padding="9,6"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     TextAlignment="Center"
                                     FontWeight="SemiBold"
                                     PreviewKeyDown="OnCaptureHotkeyPreviewKeyDown"
                                     GotKeyboardFocus="OnCaptureHotkeyGotFocus"
                                     LostKeyboardFocus="OnCaptureHotkeyLostFocus" />
                        </Grid>
                    </Border>

                    <TextBlock Text="自动清理" FontSize="18" FontWeight="SemiBold" />
                    <Border Margin="0,12" Padding="16" CornerRadius="8" Background="White">
                        <ComboBox x:Name="RetentionComboBox"
                                  Width="170"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnRetentionSelectionChanged">
                            <ComboBoxItem Content="每天清理" />
                            <ComboBoxItem Content="保留 7 天" />
                            <ComboBoxItem Content="保留 30 天" />
                        </ComboBox>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
