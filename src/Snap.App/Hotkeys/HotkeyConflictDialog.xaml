<Window x:Class="Snap.App.Hotkeys.HotkeyConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键冲突"
        Width="430"
        Height="245"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F7F7"
        ShowInTaskbar="False">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="20" Background="#FFFFF1DB">
                <TextBlock Text="!" FontSize="24" FontWeight="SemiBold" Foreground="#FFF0A020"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0">
                <TextBlock Text="截图快捷键已被占用" FontSize="17" FontWeight="SemiBold" Foreground="#FF202020" />
                <TextBlock x:Name="HotkeyText" Margin="0,5,0,0" FontSize="13" Foreground="#FF777777" />
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Margin="54,18,0,0" TextWrapping="Wrap" Foreground="#FF555555"
                   Text="可能是微信或其他软件正在使用这个快捷键。Snap 不会在后台自动重试，请关闭 Snap 或更换一个快捷键。" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="82" Height="34" Margin="0,0,8,0" Content="关闭 Snap" Click="OnCloseSnapClick" />
            <Button Width="104" Height="34" Content="更改快捷键" Background="#FF07C160" Foreground="White"
                    BorderThickness="0" Click="OnChangeClick" />
        </StackPanel>
    </Grid>
</Window>
